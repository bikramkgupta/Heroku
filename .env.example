# ============================================================
# Heroku Userbot - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# For App Platform, these are set via the app spec or UI.

# --- Telegram API (required) ---
# Get these from https://my.telegram.org/apps
# On App Platform: set via web UI after first deploy
# api_id=
# api_hash=

# --- Valkey/Redis (auto-bound on App Platform) ---
# On App Platform: automatically set via ${valkey.REDIS_URL} binding
# For local testing: run a Redis/Valkey container and set this
# REDIS_URL=redis://localhost:6379

# --- DigitalOcean Spaces (for backup) ---
# On App Platform: SPACES_ACCESS_KEY and SPACES_SECRET_KEY are secrets
# Created via: doctl spaces keys create "heroku-userbot-key" --output json
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_BUCKET=heroku-userbot-backup
# SPACES_ACCESS_KEY=
# SPACES_SECRET_KEY=

# --- Backup settings ---
# Interval in seconds between periodic backups (default: 900 = 15 min)
# BACKUP_INTERVAL=900

# --- Docker flag (set automatically in Dockerfile) ---
# DOCKER=true
